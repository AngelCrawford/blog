{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pctx := . -}}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Aktuelle Artikel - RSS Feed - {{ .Site.Title }}</description>
    <language>{{ site.Language.Locale }}</language>{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range where .Site.RegularPages "Type" "in" "articles" }}
    <item>
      <title>{{ .Title }}</title>
      {{- /*
        Cover image as <enclosure> — only when we have a Hugo Resource (so we know .Size).
        Skipped for articles without a cover Resource: RSS spec requires `length`,
        and we can't reliably compute byte size for static-folder fallback paths.
      */ -}}
      {{- $images := .Resources.ByType "image" -}}
      {{- $featured := $images.GetMatch "*cover*" -}}
      {{- with $featured }}
      <enclosure url="{{ .Permalink }}" type="{{ .MediaType.Type }}" length="{{ .Size }}" />
      {{- end }}
      {{ if .GetTerms "categories" -}}
        {{- range first 1 (.GetTerms "categories") -}}
          <category>{{- .LinkTitle -}}</category>
        {{- end -}}
      {{- end }}
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- /*
        Sanitize content for RSS readers:
        1. Resolve relative anchor hrefs (#section) to absolute via .Permalink
           — handles both single + double quotes
        2. Resolve relative img srcs to absolute, but ONLY if not already absolute
        3. Strip <svg>...</svg> blocks (RSS readers don't render SVG well, validator warns)
        4. Strip style="..." attributes (validator flags as potentially dangerous)
      */ -}}
      {{- $content := .Content -}}
      {{- $content = replaceRE `a href=(["'])(#[^"']*)["']` (printf `a href=$1%s$2$1` .Permalink) $content -}}
      {{- $content = replaceRE `img src=(["'])(?!https?:|//|/)([^"']+)["']` (printf `img src=$1%s$2$1` .Permalink) $content -}}
      {{- $content = replaceRE `<svg[\s\S]*?</svg>` "" $content -}}
      {{- $content = replaceRE `\s+style="[^"]*"` "" $content -}}
      <description>{{ $content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
