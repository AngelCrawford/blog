{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pctx := . -}}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Aktuelle Artikel - RSS Feed - {{ .Site.Title }}</description>
    <language>{{ site.Language.Locale }}</language>{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range where .Site.RegularPages "Type" "in" "articles" }}
    <item>
      <title>{{ .Title }}</title>
      {{- /*
        <enclosure> dropped entirely — RSS-Spec requires `length` (file size in bytes),
        but Hugo Resource doesn't expose .Size as a template-accessible field.
        Modern RSS readers extract cover images from <description> <img> tags anyway.
        Trade-off: simpler template, validator-clean (no missing-length errors),
        no cover thumbnail in podcast-style readers (rare for blog feeds).
      */ -}}
      {{ if .GetTerms "categories" -}}
        {{- range first 1 (.GetTerms "categories") -}}
          <category>{{- .LinkTitle -}}</category>
        {{- end -}}
      {{- end }}
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- /*
        Sanitize content for RSS readers:
        1. Resolve relative anchor hrefs (#section) to absolute via .Permalink
        2. Strip <svg>...</svg> blocks (RSS readers don't render SVG well, validator warns)
        3. Strip style="..." attributes (validator flags as potentially dangerous)

        NOTE: img src rewrite skipped — Hugo's render-image hook produces .RelPermalink
        which is root-relative (/blog/...). RSS readers resolve those against feed origin
        correctly. RE2 (Hugo's regex engine) lacks lookaheads, making it hard to match
        only "truly relative" srcs without breaking absolute URLs.
      */ -}}
      {{- $content := .Content -}}
      {{- $content = replaceRE `a href="(#[^"]*)"` (printf `a href="%s$1"` .Permalink) $content -}}
      {{- $content = replaceRE `<svg[\s\S]*?</svg>` "" $content -}}
      {{- $content = replaceRE `\s+style="[^"]*"` "" $content -}}
      <description>{{ $content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
