{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pctx := . -}}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Aktuelle Artikel - RSS Feed - {{ .Site.Title }}</description>
    <language>{{ site.Language.Locale }}</language>{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range where .Site.RegularPages "Type" "in" "articles" }}
    {{- /*
      Story 1.5: withered articles get a German "[Verwelkt Mon. YYYY]" title
      suffix and a bold deprecation paragraph prepended to <description>. The
      conditional gates on $isWithered AND $witheredDate so missing-date pages
      degrade silently to the unmodified rendering (build-time validation in
      validate-growth-stage.html should already prevent this).
    */ -}}
    {{- $isWithered := eq .Params.growth_stage "withered" -}}
    {{- $witheredDate := .Params.withered_date -}}
    {{- $witheredSuffix := "" -}}
    {{- if and $isWithered $witheredDate -}}
      {{- $monthsDe := slice "Jan." "Feb." "März" "Apr." "Mai" "Juni" "Juli" "Aug." "Sept." "Okt." "Nov." "Dez." -}}
      {{- $wt := time $witheredDate -}}
      {{- $monthIdx := int ($wt.Format "1") -}}
      {{- $witheredSuffix = printf " [Verwelkt %s %s]" (index $monthsDe (sub $monthIdx 1)) ($wt.Format "2006") -}}
    {{- end -}}
    <item>
      <title>{{ .Title }}{{ $witheredSuffix }}</title>
      {{- /*
        Cover image as Media RSS thumbnail — semantic, validator-clean, no `length` required.
        Falls back gracefully when no cover Resource exists.
        Spec: https://www.rssboard.org/media-rss
      */ -}}
      {{- $images := .Resources.ByType "image" -}}
      {{- $featured := $images.GetMatch "*cover*" -}}
      {{- with $featured }}
      <media:thumbnail url="{{ .Permalink }}" width="{{ .Width }}" height="{{ .Height }}" />
      {{- end }}
      {{ if .GetTerms "categories" -}}
        {{- range first 1 (.GetTerms "categories") -}}
          <category>{{- .LinkTitle -}}</category>
        {{- end -}}
      {{- end }}
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- /* RSS 2.0 HAS NO "UPDATED" — its only date is pubDate, which is why
             #222 argued for a second feed in Atom. It does not need one: the
             atom namespace is already declared on <rss> for the self link, so
             the element rides along in the feed everyone reads. It matters
             here more than on most blogs: tending is what orders this garden
             (#260) and what the Gepflegt flag announces (#236), and until now
             the feed was the one place that never mentioned it. Emitted only
             when it differs from the publication date. */ -}}
      {{- if ne (.Date.Format "2006-01-02") (.Lastmod.Format "2006-01-02") }}
      <atom:updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</atom:updated>
      {{- end }}
      {{- /* isPermaLink="true" is the RSS default and therefore harmless, but
             saying it out loud stops readers from guessing at a bare string. */}}
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{- /*
        Sanitize content for RSS readers:
        1. Resolve relative anchor hrefs (#section) to absolute via .Permalink
        2. Strip <svg>...</svg> blocks (RSS readers don't render SVG well, validator warns)
        3. Strip style="..." attributes (validator flags as potentially dangerous)

        NOTE: img src rewrite skipped — Hugo's render-image hook produces .RelPermalink
        which is root-relative (/blog/...). RSS readers resolve those against feed origin
        correctly. RE2 (Hugo's regex engine) lacks lookaheads, making it hard to match
        only "truly relative" srcs without breaking absolute URLs.
      */ -}}
      {{- /* THE COVER GOES INTO THE CONTENT, or no reader shows it. The
             media:thumbnail above is a hint many clients ignore, and the cover
             lives in the TEMPLATE, not in the Markdown — so a feed item began
             with a heading and no picture. Prepended as a plain <img> with an
             absolute src: that is what every reader renders. JPEG, not the
             site's WebP, because a feed lands in clients we do not control. */ -}}
      {{- $content := .Content -}}
      {{- $itemTitle := .Title -}}
      {{- with $featured }}
        {{- $feedImage := .Process "resize 1200x jpg q85" -}}
        {{- /* $itemTitle, not $.Title: inside `range`, `$` is the template's
               root — the home page — so every alt read "Home". */ -}}
        {{- $content = printf `<p><img src="%s" alt="%s" width="%d" height="%d" /></p>%s` $feedImage.Permalink ($itemTitle | htmlEscape) $feedImage.Width $feedImage.Height $content -}}
      {{- end -}}
      {{- /* `a href="…"` never matched: the heading hook writes class before
             href, so the anchors stayed relative and the validator flagged all
             ten ("description should not contain relative URL references").
             Matching the attribute alone works regardless of order. */ -}}
      {{- $content = replaceRE `href="(#[^"]*)"` (printf `href="%s$1"` .Permalink) $content -}}
      {{- $content = replaceRE `<svg[\s\S]*?</svg>` "" $content -}}
      {{- /* CLASS ATTRIBUTES ARE STRIPPED, and the W3C validator is why: our
             render hooks emit Tailwind arbitrary variants like [&_pre]:m-0 and
             [&>*:first-child]:mt-0, and a bare & inside an attribute is
             invalid HTML — 26 of them across the feed ("Named entity expected.
             Got none."). The deeper reason is that a class name is worthless
             in a feed anyway: the reader has none of our CSS and applies its
             own. Same argument as the style attributes below. */ -}}
      {{- $content = replaceRE `\s+class="[^"]*"` "" $content -}}
      {{- $content = replaceRE `\s+class='[^']*'` "" $content -}}
      {{- /* Strip BOTH double- and single-quoted style attributes (render-link.html uses single) */ -}}
      {{- $content = replaceRE `\s+style="[^"]*"` "" $content -}}
      {{- $content = replaceRE `\s+style='[^']*'` "" $content -}}
      {{- /*
        Story 1.5: prepend deprecation warning to withered articles' RSS
        description AFTER sanitization so the warning HTML is not affected by
        the <svg>/style regexes above.
      */ -}}
      {{- if and $isWithered $witheredDate -}}
        {{- $longDate := time.Format ":date_long" $witheredDate -}}
        {{- $reason := .Params.withered_reason -}}
        {{- $warning := printf "⚠️ Dieser Inhalt ist als veraltet markiert seit %s." $longDate -}}
        {{- if $reason -}}
          {{- $warning = printf "%s Grund: %s" $warning $reason -}}
        {{- end -}}
        {{- $content = printf "<p><strong>%s</strong></p>\n\n%s" $warning $content -}}
      {{- end -}}
      <description>{{ $content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
