{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pctx := . -}}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = $pctx.RegularPages -}}
{{- else -}}
{{- $pages = $pctx.Pages -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>Aktuelle Artikel - RSS Feed - {{ .Site.Title }}</description>
    <language>{{ site.Language.Locale }}</language>{{ with .Site.Copyright }}
    <copyright>{{ . }}</copyright>{{ end }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range where .Site.RegularPages "Type" "in" "articles" }}
    {{- /*
      Story 1.5: withered articles get a German "[Verwelkt Mon. YYYY]" title
      suffix and a bold deprecation paragraph prepended to <description>. The
      conditional gates on $isWithered AND $witheredDate so missing-date pages
      degrade silently to the unmodified rendering (build-time validation in
      validate-growth-stage.html should already prevent this).
    */ -}}
    {{- $isWithered := eq .Params.growth_stage "withered" -}}
    {{- $witheredDate := .Params.withered_date -}}
    {{- $witheredSuffix := "" -}}
    {{- if and $isWithered $witheredDate -}}
      {{- $monthsDe := slice "Jan." "Feb." "März" "Apr." "Mai" "Juni" "Juli" "Aug." "Sept." "Okt." "Nov." "Dez." -}}
      {{- $wt := time $witheredDate -}}
      {{- $monthIdx := int ($wt.Format "1") -}}
      {{- $witheredSuffix = printf " [Verwelkt %s %s]" (index $monthsDe (sub $monthIdx 1)) ($wt.Format "2006") -}}
    {{- end -}}
    <item>
      <title>{{ .Title }}{{ $witheredSuffix }}</title>
      {{- /*
        Cover image as Media RSS thumbnail — semantic, validator-clean, no `length` required.
        Falls back gracefully when no cover Resource exists.
        Spec: https://www.rssboard.org/media-rss
      */ -}}
      {{- $images := .Resources.ByType "image" -}}
      {{- $featured := $images.GetMatch "*cover*" -}}
      {{- with $featured }}
      <media:thumbnail url="{{ .Permalink }}" width="{{ .Width }}" height="{{ .Height }}" />
      {{- end }}
      {{ if .GetTerms "categories" -}}
        {{- range first 1 (.GetTerms "categories") -}}
          <category>{{- .LinkTitle -}}</category>
        {{- end -}}
      {{- end }}
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{- /*
        Sanitize content for RSS readers:
        1. Resolve relative anchor hrefs (#section) to absolute via .Permalink
        2. Strip <svg>...</svg> blocks (RSS readers don't render SVG well, validator warns)
        3. Strip style="..." attributes (validator flags as potentially dangerous)

        NOTE: img src rewrite skipped — Hugo's render-image hook produces .RelPermalink
        which is root-relative (/blog/...). RSS readers resolve those against feed origin
        correctly. RE2 (Hugo's regex engine) lacks lookaheads, making it hard to match
        only "truly relative" srcs without breaking absolute URLs.
      */ -}}
      {{- $content := .Content -}}
      {{- $content = replaceRE `a href="(#[^"]*)"` (printf `a href="%s$1"` .Permalink) $content -}}
      {{- $content = replaceRE `<svg[\s\S]*?</svg>` "" $content -}}
      {{- /* Strip BOTH double- and single-quoted style attributes (render-link.html uses single) */ -}}
      {{- $content = replaceRE `\s+style="[^"]*"` "" $content -}}
      {{- $content = replaceRE `\s+style='[^']*'` "" $content -}}
      {{- /*
        Story 1.5: prepend deprecation warning to withered articles' RSS
        description AFTER sanitization so the warning HTML is not affected by
        the <svg>/style regexes above.
      */ -}}
      {{- if and $isWithered $witheredDate -}}
        {{- $longDate := time.Format ":date_long" $witheredDate -}}
        {{- $reason := .Params.withered_reason -}}
        {{- $warning := printf "⚠️ Dieser Inhalt ist als veraltet markiert seit %s." $longDate -}}
        {{- if $reason -}}
          {{- $warning = printf "%s Grund: %s" $warning $reason -}}
        {{- end -}}
        {{- $content = printf "<p><strong>%s</strong></p>\n\n%s" $warning $content -}}
      {{- end -}}
      <description>{{ $content | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
