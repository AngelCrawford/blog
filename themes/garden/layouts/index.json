{{/* NOTE: Search index intentionally includes withered content per Story 1.3 AC #5. Do not filter here. */}}
[
  {{ range $index, $element := where .Site.RegularPages "Type" "in" "articles" -}}
    {{- if and $index (gt $index 0) -}},{{- end }}
    {
      "index" : {{ add 1 $index }},
      "title" : "{{ htmlEscape .Title }}",
      "tags"  : [{{ range $tindex, $tag := .Params.tags }}{{ if $tindex }}, {{ end }}"#{{ $tag | htmlEscape }}"{{ end }}],
      "content": {{ .Summary | truncate 250 "..." | plainify | jsonify }},
      "permalink": "{{ .Permalink }}",
      "publishedOn": "{{ .Date.Format "02.01.06" }}",
      "updatedOn": "{{ .Lastmod.Format "02.01.06" }}"
    }
  {{ end }}
]