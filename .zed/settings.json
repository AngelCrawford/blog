// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
    // Hugo-Templates sind Go HTML Template, nicht HTML. Die Sprache kommt aus der
    // Extension `gotmpl` (hjr265/zed-gotmpl); die beansprucht von sich aus nur
    // .gohtml und Varianten, .html muss hier zugeordnet werden. Ohne die
    // installierte Extension zeigt Zed auf den Namen unten „No language with this
    // name is installed" und die Zeile ist wirkungslos.
    //
    // DERSELBE EINTRAG STEHT IN DEN USER-SETTINGS (%APPDATA%\Zed\settings.json).
    // Wer einen aendert, aendert beide.
    "file_types": {
        "Go HTML Template": ["html"]
    },
    // Build output and caches: hidden from the project tree and, more importantly,
    // from search. Without this, every search matches the same markup three or four
    // times over — once in the source, once per copy of the rendered site.
    // `npm test` deletes the test dirs on success (scripts/clean-test-artifacts.mjs);
    // these entries also cover them mid-run and cover public/ and resources/, which
    // are never auto-deleted.
    "file_scan_exclusions": [
        "**/.git",
        "**/node_modules",
        "**/public",
        "**/public-test",
        "**/public-test-dev",
        "**/public-test-fixture",
        "**/resources",
        "**/test-results",
        "**/playwright-report",
        "**/.hugo_build.lock",
        "**/hugo_stats.json"
    ],
    // Die Sprache kommt aus der Extension `gotmpl` (hjr265/zed-gotmpl) — Zed
    // bringt keinerlei Go-Template-Sprache mit. Ohne die Extension meldet Zed
    // hier „No language with this name is installed", das file_types-Mapping
    // oben zeigt ins Leere und .html bleibt gewöhnliches HTML.
    //
    // Der Tailwind-Server hängt an dieser Sprache nicht von allein dran: seine
    // Adapter-Map (crates/languages/src/tailwind.rs) kennt nur
    // Astro/HTML/CSS/JS/TS/Svelte/HEEx/ERB/PHP/Vue. Ohne den Eintrag gäbe es in
    // 56 Template-Dateien keine einzige Klassen-Vervollständigung.
    //
    // format_on_save aus: Prettiers HTML-Parser kennt `{{ }}` nicht und würde
    // Template-Blöcke beim Speichern zerlegen.
    //
    // hard_tabs/tab_size gegen die Extension gesetzt, die `hard_tabs = true`
    // mitbringt. Im Projekt hat keine Template-Datei einen Tab.
    "languages": {
        "Go HTML Template": {
            "language_servers": ["tailwindcss-language-server", "..."],
            "format_on_save": "off",
            "hard_tabs": false,
            "tab_size": 4
        }
    },
    // YAML language server configuration for content frontmatter validation (Layer 1).
    // Source schema: schemas/frontmatter/article.schema.json
    // CAVEAT: Zed's YAML LSP validates .yaml/.yml files reliably; embedded YAML
    //         frontmatter inside .md files may not always be picked up. If editor
    //         feedback is missing, fall back to the modeline `# yaml-language-server: $schema=...`
    //         described in docs/authoring.md, and rely on the
    //         pre-commit hook (Layer 2) as the authoritative gate.
    "lsp": {
        "tailwindcss-language-server": {
            "settings": {
                // Der Server bekommt die Sprache unter einer ID gemeldet, die er
                // nicht kennt, und behandelt die Datei sonst als nicht
                // unterstützt. Die ID leitet Zed aus dem Sprachnamen ab —
                // schlicht kleingeschrieben, Leerzeichen inklusive
                // (LanguageName::lsp_id in crates/language_core).
                //
                // DIESE ZEILE HÄLT DIE COMPLETION AM LEBEN. Solange die
                // gotmpl-Extension fehlte, waren die Templates gewöhnliches
                // HTML und der Server kannte sie von sich aus; mit der
                // Extension verschwindet dieser Zufall.
                "includeLanguages": {
                    "go html template": "html"
                },
                "experimental": {
                    // Zeigt auf .zed/tailwind.css und schaltet damit die
                    // Auto-Discovery ab, die sonst tokens.css erwischt. Das
                    // Warum steht ausführlich in dieser Datei.
                    "configFile": ".zed/tailwind.css",
                    // Klassen in Templates stehen oft neben Template-Ausdrücken
                    // (`class="a {{ if … }}b{{ end }}"`); der Regex hält das
                    // Attribut auch dann zusammen.
                    "classRegex": ["class=\"([^\"]*)\""]
                }
            }
        },
        // Der CSS-Server kennt Tailwind 4 nicht und meldet @theme, @source und
        // @utility als unbekannte At-Rules — drei Fehler pro Datei, alle falsch.
        "vscode-css-language-server": {
            "settings": {
                "css": { "lint": { "unknownAtRules": "ignore" } }
            }
        },
        "yaml-language-server": {
            "settings": {
                "yaml": {
                    "schemas": {
                        "schemas/frontmatter/article.schema.json": [
                            "content/articles/**/*.md",
                            "content/notes/**/*.md"
                        ]
                    },
                    "validate": true,
                    "format": { "enable": false }
                }
            }
        }
    }
}
